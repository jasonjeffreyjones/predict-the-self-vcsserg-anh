@article{bail_review_2021,
	title = {Review of “{Breaking} the {Social} {Media} {Prism}: {How} to {Make} {Our} {Platforms} {Less} {Polarizing}”},
	issn = {0037-7732},
	shorttitle = {Review of “{Breaking} the {Social} {Media} {Prism}},
	url = {https://doi.org/10.1093/sf/soab074},
	doi = {10.1093/sf/soab074},
	abstract = {Breaking the Social Media Prism: How to Make our Platforms Less Polarizing by Chris Bail makes a giant promise on the cover. Within its pages, Bail delivers an efficient, engaging treatise on the polarizing effects of social media in the USA, but tacks in odd directions when it comes to suggesting potential remedies.Bail is the director of Duke University’s Polarization Lab, a multi-disciplinary team studying the role of technology in our current age of antagonistic political division. In this book, he expertly marshals evidence from his own research and modern computational social science to demonstrate how common narratives of social media miss the mark. Echo chambers and filter bubbles are evocative metaphors, but Americans actually are exposed to a wide spectrum of political opinion. Politically driven disinformation is not widespread nor widely believed. From his own work, he deftly presents an ambitious field experiment with surprising results that challenge a commonplace narrative.},
	number = {soab074},
