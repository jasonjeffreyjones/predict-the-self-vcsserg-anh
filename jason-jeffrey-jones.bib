	month = jul,
	year = {2008},
	note = {Place: Washington
WOS:000257467600010},
	keywords = {sleep, consolidation, cortex, dream, enhancement, memory consolidation, motor skill, neuroscience, plasticity, power-law, reality, skills, time-course},
	pages = {834--842},
}

@article{bond_social_2017-2,
