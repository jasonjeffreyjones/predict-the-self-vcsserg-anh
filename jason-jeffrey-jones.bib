@misc{noauthor_yellow_2015,
	title = {The {Yellow} {Kid}},
	copyright = {Creative Commons Attribution-ShareAlike License},
	url = {http://en.wikipedia.org/w/index.php?title=The_Yellow_Kid&oldid=648087254},
	abstract = {The Yellow Kid was the name of a lead American comic strip character that ran from 1895 to 1898 in Joseph Pulitzer's New York World, and later William Randolph Hearst's New York Journal. Created and drawn by Richard F. Outcault in the comic strip Hogan's Alley (and later under other names as well), it was one of the first Sunday supplement comic strips in an American newspaper, although its graphical layout had already been thoroughly established in political and other, purely-for-entertainment cartoons. Outcault's use of word balloons in the Yellow Kid influenced the basic appearance and use of balloons in subsequent newspaper comic strips and comic books.
Although a cartoon, Outcault's work aimed its humor and social commentary at Pulitzer's adult readership. The strip has been described as "... a turn-of-the-century theater of the city, in which class and racial tensions of the new urban, consumerist environment were acted out by a mischievous group of New York City kids from the wrong side of the tracks."
The Yellow Kid is also famous for its connection to the coining of the term yellow journalism.},
	language = {en},
	urldate = {2015-03-01},
	journal = {Wikipedia, the free encyclopedia},
