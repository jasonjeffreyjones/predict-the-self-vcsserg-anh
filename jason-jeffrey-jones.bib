@article{shirado_locally_2017,
	title = {Locally noisy autonomous agents improve global human coordination in network experiments},
	volume = {545},
	copyright = {© 2017 Macmillan Publishers Limited, part of Springer Nature. All rights reserved.},
	issn = {0028-0836},
	url = {http://www.nature.com.proxy.library.stonybrook.edu/nature/journal/v545/n7654/full/nature22332.html},
	doi = {10.1038/nature22332},
	abstract = {Coordination in groups faces a sub-optimization problem and theory suggests that some randomness may help to achieve global optima. Here we performed experiments involving a networked colour coordination game in which groups of humans interacted with autonomous software agents (known as bots). Subjects (n = 4,000) were embedded in networks (n = 230) of 20 nodes, to which we sometimes added 3 bots. The bots were programmed with varying levels of behavioural randomness and different geodesic locations. We show that bots acting with small levels of random noise and placed in central locations meaningfully improve the collective performance of human groups, accelerating the median solution time by 55.6\%. This is especially the case when the coordination problem is hard. Behavioural randomness worked not only by making the task of humans to whom the bots were connected easier, but also by affecting the gameplay of the humans among themselves and hence creating further cascades of benefit in global coordination in these heterogeneous systems.},
	language = {en},
	number = {7654},
	urldate = {2017-05-18},
	journal = {Nature},
	author = {Shirado, Hirokazu and Christakis, Nicholas A.},
	month = may,
	year = {2017},
	keywords = {Sociology, Human behaviour, Network topology, Social evolution},
	pages = {370--374},
	file = {Full Text PDF:C\:\\Users\\jason\\Zotero\\storage\\SSKAI3GK\\Shirado and Christakis - 2017 - Locally noisy autonomous agents improve global hum.pdf:application/pdf;Snapshot:C\:\\Users\\jason\\Zotero\\storage\\XJSHEKWV\\nature22332.html:text/html},
}

@inproceedings{hutto_longitudinal_2013,
