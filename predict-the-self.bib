@article{griffo_who_2021,
	title = {Who {Am} {I}? {Let} {Me} {Think}: {Assessing} the {Considered} {Self}-{Concept}},
	volume = {11},
	issn = {2158-2440},
	shorttitle = {Who {Am} {I}?},
	url = {https://doi.org/10.1177/21582440211004278},
	doi = {10.1177/21582440211004278},
	abstract = {My Multiple Selves (MMS) is an open-ended self-concept measure that leads respondents to systematically explore who they are before selecting and rank-ordering their most important selves. A sample of college students (n = 204) completed either the MMS or the frequently used Twenty Statements Test (TST). As predicted, results demonstrated that MMS responses included elements underdetected by the TST: other people, school crowd labels, aspirations for the future, and undesirable selves. Furthermore, the MMS revealed that when other people are included in self, they are rank ordered by participants as the most important element. Shortcomings of the MMS are discussed, and directions for future research outlined.},
	language = {en},
	number = {1},
	urldate = {2021-07-14},
	journal = {SAGE Open},
	publisher = {SAGE Publications},
	author = {Griffo, Robert and Lemay, Edward and Moreno, Amanda H.},
	month = jan,
	year = {2021},
	keywords = {open-ended self-concept assessment, self-concept content, self-concept structure, social identity},
	pages = {21582440211004278},
	file = {SAGE PDF Full Text:C\:\\Users\\jason\\Zotero\\storage\\SAMJI9XM\\Griffo et al. - 2021 - Who Am I Let Me Think Assessing the Considered S.pdf:application/pdf},
}

